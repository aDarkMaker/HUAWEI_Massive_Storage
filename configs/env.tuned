# Baseline configuration with the build-time throughput knobs opened up.
#
# The reference run pins MAX_ASYNC, WORKERS and MAX_CONCURRENT_FILES to 1 while
# the vLLM server is started with --max-num-seqs 4, so the pipeline leaves most
# of the serving capacity idle and pays the full build-time penalty.
#
# Only throughput and caching are changed here; every retrieval and chunking
# parameter matches configs/env.baseline so accuracy stays comparable.

# --- Model endpoints ---
LLM_BINDING_HOST=http://127.0.0.1:8100/v1
LLM_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct
VLLM_BINDING_HOST=http://127.0.0.1:8100/v1
VLLM_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct
EMBEDDING_MODEL=/hdd/lmq/model/bge-m3
EMBEDDING_BINDING_HOST=http://127.0.0.1:8001/v1

JUDGER_API_KEY="api-key"
JUDGER_BINDING_HOST=http://127.0.0.1:8100/v1
JUDGER_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct

RERANK_MODEL=/hdd/lmq/model/bge-reranker-v2-m3
RERANK_ENDPOINT=http://127.0.0.1:8002/v1/rerank
RERANK_API_KEY="api-key"
RERANK_TOP_N=10

# --- Paths. Overridden with absolute values by scripts/build_index.sh ---
BENCHMARK_NAME=UNIDOCBENCH_0713_retry
BENCH_FORCE_RERUN=true
BENCH_QUERIES=assets/queries_30.json
RAG_STORAGE=index/current
DOC_FILE_PATH=data/parsed_norm
RAG_BINDING_HOST=http://127.0.0.1:8080/query
LOG_DIR=./all_logs

# --- Retrieval settings ---
QUERY_MODE=mix
CHUNK_TOPK=40
ENTITY_TOPK=30
QUERY_MAX_ENTITY_TOKENS=600
QUERY_MAX_RELATION_TOKENS=600
QUERY_MAX_TOTAL_TOKENS=126000
QUERY_MAX_TOKENS=512
QUERY_VLM_ENHANCED=true

# --- Chunking and extraction ---
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIM=false
CHUNK_SIZE=300
CHUNK_OVERLAP_SIZE=15
MAX_TOKEN_TEXT_CHUNK=500
MAX_TOKEN_RELATION_DESC=500
MAX_TOKEN_ENTITY_DESC=500
LLM_TIMEOUT=1200
MAX_TOKENS=1024
TEMPERATURE=0
MAX_GLEANING=0
MAX_EXTRACTION_RECORDS=40
MAX_EXTRACTION_ENTITIES=20

# --- Throughput opened up to match --max-num-seqs 4 on the vLLM server ---
MAX_CONCURRENT_FILES=4
WORKERS=4
MAX_ASYNC=8
MAX_PARALLEL_INSERT=4
EMBEDDING_FUNC_MAX_ASYNC=16
EMBEDDING_BATCH_NUM=16

# The reference run left the extraction cache effectively unused
# (kv_store_llm_response_cache.json was 28 KB for a 1.1 GB store), which forces
# a full re-extraction on every rebuild. Enable it so retrieval experiments can
# iterate without rebuilding the index.
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true

# --- Parser ---
DOCS_PATH=data/raw/pdfs
PARSER_NAME=mineru
PARSER_OUTPUT_DIR=data/parsed
MINERU_VLM=false
SKIP_FILE_PATHS=

MAX_TOTAL_TOKENS=126000
DEFAULT_MAX_TOTAL_TOKENS=30000

# --- Score baseline from the organiser's reference run ---
BASELINE_SEARCH_TIME=2300
BASELINE_BUILD_TIME=3224
