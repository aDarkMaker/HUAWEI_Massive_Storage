# Verbatim snapshot of the organiser's reference configuration.
# Source: third_party/RAG-Anything/env.runtime.txt (identical to env.example
# as shipped) plus the baseline timings from the experiments dotenv.
# Throughput knobs are intentionally left at their as-shipped values so this
# file reproduces the reference build and search times.

# --- Model endpoints ---
LLM_BINDING_HOST=http://127.0.0.1:8100/v1
LLM_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct
VLLM_BINDING_HOST=http://127.0.0.1:8100/v1
VLLM_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct
EMBEDDING_MODEL=/hdd/lmq/model/bge-m3
EMBEDDING_BINDING_HOST=http://127.0.0.1:8001/v1

JUDGER_API_KEY="api-key"
JUDGER_BINDING_HOST=http://127.0.0.1:8100/v1
JUDGER_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct

RERANK_MODEL=/hdd/lmq/model/bge-reranker-v2-m3
RERANK_ENDPOINT=http://127.0.0.1:8002/v1/rerank
RERANK_API_KEY="api-key"
RERANK_TOP_N=10

# --- Paths. Overridden with absolute values by scripts/build_index.sh ---
BENCHMARK_NAME=UNIDOCBENCH_0713_retry
BENCH_FORCE_RERUN=true
BENCH_QUERIES=assets/queries_30.json
RAG_STORAGE=index/baseline_repro
DOC_FILE_PATH=data/parsed
RAG_BINDING_HOST=http://127.0.0.1:8080/query
LOG_DIR=./all_logs

# --- Retrieval settings ---
QUERY_MODE=mix
CHUNK_TOPK=40
ENTITY_TOPK=30
QUERY_MAX_ENTITY_TOKENS=600
QUERY_MAX_RELATION_TOKENS=600
QUERY_MAX_TOTAL_TOKENS=126000
QUERY_MAX_TOKENS=512
QUERY_VLM_ENHANCED=true

# --- Chunking and extraction ---
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIM=false
CHUNK_SIZE=300
CHUNK_OVERLAP_SIZE=15
MAX_TOKEN_TEXT_CHUNK=500
MAX_TOKEN_RELATION_DESC=500
MAX_TOKEN_ENTITY_DESC=500
LLM_TIMEOUT=1200
MAX_TOKENS=1024
TEMPERATURE=0
MAX_GLEANING=0
MAX_EXTRACTION_RECORDS=40
MAX_EXTRACTION_ENTITIES=20

# --- Throughput as shipped by the organiser ---
MAX_CONCURRENT_FILES=1
WORKERS=1
MAX_ASYNC=1
EMBEDDING_FUNC_MAX_ASYNC=8

# --- Parser ---
DOCS_PATH=data/raw/pdfs
PARSER_NAME=mineru
PARSER_OUTPUT_DIR=data/parsed
MINERU_VLM=false
SKIP_FILE_PATHS=

MAX_TOTAL_TOKENS=126000
DEFAULT_MAX_TOTAL_TOKENS=30000

# --- Score baseline from the organiser's reference run ---
BASELINE_SEARCH_TIME=2300
BASELINE_BUILD_TIME=3224
