# Virtualenv and caches
.venv/
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor and packaging caches (including ones left inside the vendored tree)
.vscode/
.idea/
*.egg-info/

# Local environment overrides
.env
.env.local
.env.*.local

# Competition data and generated artifacts (kept out of git on purpose)
/data/
/index/
/runs/

# Runtime state the vendored tree creates when scripts are run from inside it:
# the server writes its own copy of the store there, and normalize/serve leave a
# symlink named mineru-parsed behind. Both are regenerated, so neither belongs
# in version control.
/third_party/RAG-Anything/rag_storage/
/third_party/RAG-Anything/index/
/third_party/RAG-Anything/mineru-parsed
/third_party/RAG-Anything/all_logs/

# Logs
*.log
